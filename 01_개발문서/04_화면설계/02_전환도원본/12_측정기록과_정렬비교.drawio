<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" type="device"><diagram id="measurement-workflow" name="측정 기록과 정렬 비교"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="1000"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="TraceWave Studio / 측정 기록과 비교&#10;자료 분류, 교정 조건, 수치 차이와 실측 판정을 각각 확인" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8f2ff;strokeColor=#adc5dd;fontFamily=Malgun Gothic;fontSize=18;"><mxGeometry x="65" y="44" width="1470" height="108" as="geometry" /></mxCell><mxCell id="file" value="파일과 형식&#10;Touchstone / CSV / HDF5 원문 선택&#10;읽을 수 있는 크기와 형식 확인" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#adc5dd;fontFamily=Malgun Gothic;fontSize=18;"><mxGeometry x="65" y="205" width="345" height="125" as="geometry" /></mxCell><mxCell id="mapping" value="열 / 포트 대응&#10;주파수 단위 / 포트 / Z0 대응&#10;기준면 미정값 유지" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#adc5dd;fontFamily=Malgun Gothic;fontSize=18;"><mxGeometry x="440" y="205" width="345" height="125" as="geometry" /></mxCell><mxCell id="record" value="시료와 교정&#10;시료 / 취득 / 교정 / 설치 / 환경&#10;불확도와 원문 첨부 연결" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#adc5dd;fontFamily=Malgun Gothic;fontSize=18;"><mxGeometry x="815" y="205" width="345" height="125" as="geometry" /></mxCell><mxCell id="review" value="가져오기 검토&#10;실제 곡선과 조건 확인&#10;원문과 기록을 한 번에 적용" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#adc5dd;fontFamily=Malgun Gothic;fontSize=18;"><mxGeometry x="1190" y="205" width="345" height="125" as="geometry" /></mxCell><mxCell id="source" value="비교 &gt; 측정&#10;기준과 비교 자료를 명시 선택&#10;자료와 기록의 개정 고정" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#adc5dd;fontFamily=Malgun Gothic;fontSize=18;"><mxGeometry x="65" y="415" width="345" height="125" as="geometry" /></mxCell><mxCell id="align" value="필요하면 자료 정렬&#10;포트 순열 / Z0 / 선형 RI&#10;순서와 보간 지점을 확인" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#adc5dd;fontFamily=Malgun Gothic;fontSize=18;"><mxGeometry x="440" y="415" width="345" height="125" as="geometry" /></mxCell><mxCell id="compare" value="복소 차이와 조건&#10;곡선 / 표본 / 교정과 시료 차이&#10;비교 불가 이유와 미정 조건" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#adc5dd;fontFamily=Malgun Gothic;fontSize=18;"><mxGeometry x="815" y="415" width="345" height="125" as="geometry" /></mxCell><mxCell id="save" value="비교 보고서 저장&#10;전체 표본과 조건을 고정&#10;이름과 변경 이유를 기록" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#adc5dd;fontFamily=Malgun Gothic;fontSize=18;"><mxGeometry x="1190" y="415" width="345" height="125" as="geometry" /></mxCell><mxCell id="edge0" source="file" target="mapping" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#557894;"><mxGeometry relative="1" as="geometry"><mxPoint x="410" y="267" as="sourcePoint" /><mxPoint x="440" y="267" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge1" source="mapping" target="record" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#557894;"><mxGeometry relative="1" as="geometry"><mxPoint x="785" y="267" as="sourcePoint" /><mxPoint x="815" y="267" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge2" source="record" target="review" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#557894;"><mxGeometry relative="1" as="geometry"><mxPoint x="1160" y="267" as="sourcePoint" /><mxPoint x="1190" y="267" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge4" source="source" target="align" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#557894;"><mxGeometry relative="1" as="geometry"><mxPoint x="410" y="477" as="sourcePoint" /><mxPoint x="440" y="477" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge5" source="align" target="compare" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#557894;"><mxGeometry relative="1" as="geometry"><mxPoint x="785" y="477" as="sourcePoint" /><mxPoint x="815" y="477" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge6" source="compare" target="save" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#557894;"><mxGeometry relative="1" as="geometry"><mxPoint x="1160" y="477" as="sourcePoint" /><mxPoint x="1190" y="477" as="targetPoint" /></mxGeometry></mxCell><mxCell id="reopen" value="저장 / 종료 / 다시 열기&#10;측정 기록, 정렬 이력, 비교 보고서를 선택해 기존 자료를 조회&#10;처음 적용한 개정과 원본 hash를 사용" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#edf8f3;strokeColor=#adc5dd;fontFamily=Malgun Gothic;fontSize=18;"><mxGeometry x="65" y="616" width="1470" height="128" as="geometry" /></mxCell><mxCell id="edge8" source="save" target="reopen" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#557894;"><mxGeometry relative="1" as="geometry"><mxPoint x="1362" y="540" as="sourcePoint" /><mxPoint x="1362" y="616" as="targetPoint" /></mxGeometry></mxCell><mxCell id="recovery" value="오류 / 응답 불명&#10;사용자가 입력을 고쳐 다시 검토하거나 원래 요청의 영수증을 조회&#10;물리 정확도와 실측 수용은 실제 자료 확보 후 별도 검증" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff5e5;strokeColor=#adc5dd;fontFamily=Malgun Gothic;fontSize=18;"><mxGeometry x="65" y="815" width="1470" height="125" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>