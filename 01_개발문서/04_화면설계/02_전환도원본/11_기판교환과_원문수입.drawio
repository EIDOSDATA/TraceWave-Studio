<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" type="device"><diagram id="pcb-cam-import" name="PCB 교환과 원문 수입"><mxGraphModel dx="1420" dy="800" grid="1" gridSize="10" page="1" pageWidth="1420" pageHeight="800"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="PCB / CAM 작업 전환" vertex="1" parent="1" style="text;html=0;fontFamily=Malgun Gothic;fontSize=18;"><mxGeometry x="45" y="10" width="1300" height="35" as="geometry" /></mxCell><mxCell id="subtitle" value="현재 설계, 고정 출력, 가져올 원문을 구분하고 검토한 변경만 적용한다." vertex="1" parent="1" style="text;html=0;fontFamily=Malgun Gothic;fontSize=18;"><mxGeometry x="45" y="50" width="1300" height="35" as="geometry" /></mxCell><mxCell id="edit" value="현재 설계 / 적용된 개정&#10;출처와 미정값, 객체 이름 유지" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#b9cce0;fontColor=#263d55;fontFamily=Malgun Gothic;fontSize=18;" vertex="1" parent="1"><mxGeometry x="45" y="115" width="400" height="95" as="geometry" /></mxCell><mxCell id="features" value="홀 / 슬롯 / 풋프린트 / 개구&#10;전용 폼에서 후보와 변경 목록 검토" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#b9cce0;fontColor=#263d55;fontFamily=Malgun Gothic;fontSize=18;" vertex="1" parent="1"><mxGeometry x="45" y="260" width="400" height="95" as="geometry" /></mxCell><mxCell id="applyfeature" value="한 명령으로 적용&#10;undo / redo와 선택 동기화" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#b9cce0;fontColor=#263d55;fontFamily=Malgun Gothic;fontSize=18;" vertex="1" parent="1"><mxGeometry x="45" y="405" width="400" height="95" as="geometry" /></mxCell><mxCell id="snapshot" value="출력 입력 고정&#10;현재 또는 보존 snapshot 선택" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#b9cce0;fontColor=#263d55;fontFamily=Malgun Gothic;fontSize=18;" vertex="1" parent="1"><mxGeometry x="505" y="115" width="400" height="95" as="geometry" /></mxCell><mxCell id="review" value="KiCad / Gerber / 드릴 / Job&#10;원본-대상 대응과 실제 포함 범위 검토" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#b9cce0;fontColor=#263d55;fontFamily=Malgun Gothic;fontSize=18;" vertex="1" parent="1"><mxGeometry x="505" y="260" width="400" height="95" as="geometry" /></mxCell><mxCell id="export" value="별도 worker 출력&#10;원문 sidecar + 파일 재읽기 보고서" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#b9cce0;fontColor=#263d55;fontFamily=Malgun Gothic;fontSize=18;" vertex="1" parent="1"><mxGeometry x="505" y="405" width="400" height="95" as="geometry" /></mxCell><mxCell id="verify" value="보존 파일의 새 재검수&#10;원래 파일 / 보고서는 수정하지 않음" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#b9cce0;fontColor=#263d55;fontFamily=Malgun Gothic;fontSize=18;" vertex="1" parent="1"><mxGeometry x="505" y="550" width="400" height="95" as="geometry" /></mxCell><mxCell id="upload" value="가져올 원문 파일 선택&#10;파일명 / bytes / hash와 전송 진행" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#b9cce0;fontColor=#263d55;fontFamily=Malgun Gothic;fontSize=18;" vertex="1" parent="1"><mxGeometry x="965" y="115" width="400" height="95" as="geometry" /></mxCell><mxCell id="parse" value="원문 봉인 / 별도 parser&#10;조회 실패나 중단에도 원문 보존" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#b9cce0;fontColor=#263d55;fontFamily=Malgun Gothic;fontSize=18;" vertex="1" parent="1"><mxGeometry x="965" y="260" width="400" height="95" as="geometry" /></mxCell><mxCell id="mapping" value="층 / net 대응 + 손실 확인&#10;후보와 현재 설계를 나란히 검토" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#b9cce0;fontColor=#263d55;fontFamily=Malgun Gothic;fontSize=18;" vertex="1" parent="1"><mxGeometry x="965" y="405" width="400" height="95" as="geometry" /></mxCell><mxCell id="applyimport" value="검토한 후보 한 번 적용&#10;원문 출처 / 역명령 / 영수증 보존" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#b9cce0;fontColor=#263d55;fontFamily=Malgun Gothic;fontSize=18;" vertex="1" parent="1"><mxGeometry x="965" y="550" width="400" height="95" as="geometry" /></mxCell><mxCell id="reopen" value="저장 / 종료 / 재열기&#10;원문과 보존 결과를 다시 조회" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#b9cce0;fontColor=#263d55;fontFamily=Malgun Gothic;fontSize=18;" vertex="1" parent="1"><mxGeometry x="45" y="550" width="400" height="95" as="geometry" /></mxCell><mxCell id="edge0" source="edit" target="features" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#547797;"><mxGeometry relative="1" as="geometry"><mxPoint x="245" y="210" as="sourcePoint" /><mxPoint x="245" y="252" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge1" source="features" target="applyfeature" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#547797;"><mxGeometry relative="1" as="geometry"><mxPoint x="245" y="355" as="sourcePoint" /><mxPoint x="245" y="397" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge2" source="applyfeature" target="reopen" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#547797;"><mxGeometry relative="1" as="geometry"><mxPoint x="245" y="500" as="sourcePoint" /><mxPoint x="245" y="542" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge3" source="edit" target="snapshot" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#547797;"><mxGeometry relative="1" as="geometry"><mxPoint x="445" y="162" as="sourcePoint" /><mxPoint x="497" y="162" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge4" source="snapshot" target="review" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#547797;"><mxGeometry relative="1" as="geometry"><mxPoint x="705" y="210" as="sourcePoint" /><mxPoint x="705" y="252" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge5" source="review" target="export" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#547797;"><mxGeometry relative="1" as="geometry"><mxPoint x="705" y="355" as="sourcePoint" /><mxPoint x="705" y="397" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge6" source="export" target="verify" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#547797;"><mxGeometry relative="1" as="geometry"><mxPoint x="705" y="500" as="sourcePoint" /><mxPoint x="705" y="542" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge7" source="upload" target="parse" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#547797;"><mxGeometry relative="1" as="geometry"><mxPoint x="1165" y="210" as="sourcePoint" /><mxPoint x="1165" y="252" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge8" source="parse" target="mapping" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#547797;"><mxGeometry relative="1" as="geometry"><mxPoint x="1165" y="355" as="sourcePoint" /><mxPoint x="1165" y="397" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge9" source="mapping" target="applyimport" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#547797;"><mxGeometry relative="1" as="geometry"><mxPoint x="1165" y="500" as="sourcePoint" /><mxPoint x="1165" y="542" as="targetPoint" /></mxGeometry></mxCell><mxCell id="failure" value="실패 / 결과 불명: 현재 원본 유지, 원래 요청의 영수증과 작업 상태 조회&#10;새 키로 자동 반복하지 않음. 파일 생성 / 형식 검수 / 수신 도구 검사 / 제작·실측 검증은 별도 상태." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff5e4;strokeColor=#e2bf7b;fontFamily=Malgun Gothic;fontSize=18;"><mxGeometry x="45" y="680" width="1320" height="82" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>