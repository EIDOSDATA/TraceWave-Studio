{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows-release",
      "displayName": "Windows wxMSW Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON",
        "RFAD_WX_SOURCE_DIR": "${sourceDir}/.local/deps/wxWidgets-3.2.12",
        "RFAD_JSON_INCLUDE_DIR": "${sourceDir}/.local/deps/json-3.12.0"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "targets": ["tracewave_gui", "tracewave_canvas_geometry_tests", "tracewave_display_mesh_tests"]
    }
  ],
  "testPresets": [
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "output": {"outputOnFailure": true}
    }
  ]
}
