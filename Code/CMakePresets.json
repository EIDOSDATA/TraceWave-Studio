{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows-release",
      "displayName": "Windows wxMSW Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON",
        "RFAD_WX_SOURCE_DIR": "${sourceDir}/.local/deps/wxWidgets-3.2.12",
        "RFAD_JSON_INCLUDE_DIR": "${sourceDir}/.local/deps/json-3.12.0"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "targets": ["tracewave_gui", "tracewave_canvas_geometry_tests", "tracewave_display_mesh_tests", "tracewave_gui_presentation_tests", "tracewave_gui_state_tests", "tracewave_pcb_selection_tests", "tracewave_pcb_suggestion_tests", "tracewave_radiation_pattern_tests", "tracewave_study_report_tests", "tracewave_project_study_tests"]
    }
  ],
  "testPresets": [
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "output": {"outputOnFailure": true}
    }
  ]
}
